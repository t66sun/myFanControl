<Window x:Class="ThinkBookControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ThinkBookControl.Controls" Title="ThinkBookControl · 风扇控制" Width="960" Height="760" MinWidth="800" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F5F7F9" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#203044">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#CAD3DE"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#203044"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="#CAD3DE"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,4,0,0"/></Style>
 </Window.Resources>
 <Grid Margin="22,18" Background="#F5F7F9"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16"><TextBlock Text="ThinkBookControl" FontSize="24" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="当前模式  " VerticalAlignment="Center" Foreground="#59697B"/><TextBlock x:Name="ControlModeText" Text="固件控制" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#DAE1E9" BorderThickness="1" Padding="18,12" Margin="0,0,0,16"><UniformGrid Columns="4">
   <StackPanel><TextBlock Text="CPU 温度" Foreground="#59697B"/><TextBlock x:Name="CpuTemperatureText" Style="{StaticResource Metric}" Text="不可用"/><TextBlock Text="两路曲线的控制温度" Foreground="#59697B" Margin="0,4,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="GPU 温度" Foreground="#59697B"/><TextBlock x:Name="GpuTemperatureText" Style="{StaticResource Metric}" Text="不可用"/><TextBlock Text="仅用于监测" Foreground="#59697B" Margin="0,4,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="风扇 1 · 实际 RPM" Foreground="#59697B"/><TextBlock x:Name="Fan1ActualText" Style="{StaticResource Metric}" Text="不可用"/><TextBlock x:Name="Fan1TargetText" Text="已应用目标：—" Foreground="#59697B" Margin="0,4,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="风扇 2 · 实际 RPM" Foreground="#59697B"/><TextBlock x:Name="Fan2ActualText" Style="{StaticResource Metric}" Text="不可用"/><TextBlock x:Name="Fan2TargetText" Text="已应用目标：—" Foreground="#59697B" Margin="0,4,0,0"/></StackPanel>
  </UniformGrid></Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TabControl x:Name="EditorTabs" SelectionChanged="OnEditorTabChanged" Background="White" BorderBrush="#DAE1E9" Padding="14">
    <TabItem Header="自动曲线"><StackPanel x:Name="CurveEditorPanel">
     <DockPanel Margin="0,0,0,6"><TextBlock Text="双路曲线" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="静态映射预览 · 拖拽节点调整" Foreground="#59697B" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
     <WrapPanel Margin="0,0,0,8"><ComboBox x:Name="PresetPicker" Width="195" DisplayMemberPath="Name" SelectionChanged="OnPresetChanged" Margin="0,0,10,0"/><Button x:Name="SavePresetButton" Content="保存" Click="OnSavePresetClick"/><Button x:Name="SaveAsPresetButton" Content="另存为" Click="OnSaveAsPresetClick"/><Button x:Name="RenamePresetButton" Content="重命名" Click="OnRenamePresetClick"/><Button x:Name="DeletePresetButton" Content="删除" Click="OnDeletePresetClick"/></WrapPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="210"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <controls:CurveEditor x:Name="CurveGraph" Grid.Row="0" Grid.Column="0" Height="210"/>
      <DataGrid x:Name="NodeGrid" Grid.Row="0" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" Height="210" MinRowHeight="30" BeginningEdit="OnNodeBeginningEdit" CellEditEnding="OnNodeCellEditEnding" BorderBrush="#DAE1E9"><DataGrid.Columns>
       <DataGridTextColumn Header="温度 °C" Binding="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" Width="80"/><DataGridTextColumn Header="目标 RPM" Binding="{Binding Rpm, UpdateSourceTrigger=PropertyChanged}" Width="90"/><DataGridTextColumn Header="校验" Binding="{Binding Error}" IsReadOnly="True" Width="138"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#A33226"/><Setter Property="Margin" Value="4"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      </DataGrid.Columns></DataGrid>
      <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"><RadioButton x:Name="Fan1Choice" Content="风扇 1 · 蓝线" IsChecked="True" Checked="OnSelectedFanChanged" Margin="0,7,12,0" Foreground="#1D5DB0"/><RadioButton x:Name="Fan2Choice" Content="风扇 2 · 橙线" Checked="OnSelectedFanChanged" Margin="0,7,12,0" Foreground="#A45B13"/><Button Content="1 → 2 复制" ToolTip="将风扇 1 曲线复制到风扇 2" Click="OnCopyFan1Click"/><Button Content="2 → 1 复制" ToolTip="将风扇 2 曲线复制到风扇 1" Click="OnCopyFan2Click"/></WrapPanel>
      <WrapPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"><Button x:Name="AddNodeButton" Content="增加节点" Click="OnAddNodeClick"/><Button x:Name="RemoveNodeButton" Content="删除所选节点" Click="OnRemoveNodeClick"/></WrapPanel>
     </Grid>
     <TextBlock Text="至少 2 个节点；末点固定 7500 RPM，温度 ≤ 90°C。" Foreground="#59697B" Margin="0,6,0,0" FontSize="12"/>
     <TextBlock x:Name="CurveValidationText" Foreground="#A33226" Margin="0,8,0,0"/>
    </StackPanel></TabItem>
    <TabItem Header="手动控制"><StackPanel x:Name="ManualEditorPanel" Margin="4,10"><TextBlock Text="固定双路转速" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="允许 1500–7500 RPM，步长 100。CPU 达到 90°C 时仍会启用高温保护。" Foreground="#59697B" Margin="0,8,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="风扇 1 · RPM"/><TextBox x:Name="Fan1RpmBox" Text="3600" TextChanged="OnManualDraftChanged" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="风扇 2 · RPM"/><TextBox x:Name="Fan2RpmBox" Text="3600" TextChanged="OnManualDraftChanged" Margin="0,8,0,0"/></StackPanel></Grid><TextBlock x:Name="ManualValidationText" Foreground="#A33226" Margin="0,10,0,0"/><TextBlock Text="修改输入不会改变转速。点击下方“应用手动转速”后才启用控制。" Foreground="#59697B" Margin="0,18,0,0"/></StackPanel></TabItem>
   </TabControl>
   <Expander Header="设备、完整传感器与诊断详情" Margin="0,14,0,12"><StackPanel Margin="12,10"><TextBlock x:Name="ModelText"/><TextBlock x:Name="BiosText"/><TextBlock x:Name="BiosDateText"/><TextBlock x:Name="ThermalText"/><TextBlock x:Name="VpcText"/><GroupBox x:Name="SensorsGroup" Header="每秒采样" Margin="0,8"><ScrollViewer x:Name="SensorsScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="TemperatureText" FontFamily="Consolas"/></ScrollViewer></GroupBox><TextBlock x:Name="StatusText"/><ScrollViewer x:Name="ErrorsScroll" MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ErrorsText" Foreground="#A33226"/></ScrollViewer></StackPanel></Expander>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="3" BorderBrush="#DAE1E9" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel><TextBlock x:Name="DraftStatusText" Foreground="#59697B" Margin="0,0,0,6"/><TextBlock x:Name="ControlStatusText" Text="当前由固件控制；控制功能不会在启动时自动启用。" Margin="0,0,0,5"/><TextBlock x:Name="SettingsStatusText" Foreground="#A33226" Margin="0,0,0,5"/><DockPanel><Button x:Name="ApplyButton" Content="应用自动曲线" Background="#1D5DB0" Foreground="White" BorderBrush="#1D5DB0" Click="OnApplyClick"/><Button x:Name="RestoreButton" Content="恢复固件控制" Click="OnRestoreFirmwareClick"/><TextBlock Text="关闭窗口后继续在托盘运行" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#59697B"/></DockPanel></StackPanel></Border>
  <TextBox x:Name="Fan1CurveBox" Visibility="Collapsed" Text="40:2500;60:3500;75:5000;90:7500"/><TextBox x:Name="Fan2CurveBox" Visibility="Collapsed" Text="40:2500;60:3500;75:5000;90:7500"/>
 </Grid>
</Window>


