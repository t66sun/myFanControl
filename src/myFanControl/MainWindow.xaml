<Window x:Class="myFanControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:myFanControl.Controls"
        Title="myFanControl · 风扇控制" Width="960" Height="760" MinWidth="800" MinHeight="640"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Background="{DynamicResource Canvas}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/VisualTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Window.Foreground><StaticResource ResourceKey="Ink"/></Window.Foreground>
    <Grid Margin="24,16" Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" Background="{DynamicResource Accent}" CornerRadius="10" Margin="0,0,12,0">
                    <Viewbox Margin="9" IsHitTestVisible="False"><Canvas Width="24" Height="24">
                            <Path Stroke="{DynamicResource AccentForeground}" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M 12,10 C 7,10 4,6 7,3 C 11,0 14,4 12,10 M 14,12 C 14,7 18,4 21,7 C 24,11 20,14 14,12 M 12,14 C 17,14 20,18 17,21 C 13,24 10,20 12,14 M 10,12 C 10,17 6,20 3,17 C 0,13 4,10 10,12"/>
                        <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentForeground}" Canvas.Left="10" Canvas.Top="10"/>
                    </Canvas></Viewbox>
                </Border>
                <TextBlock Text="myFanControl" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Button x:Name="ThemeColorButton" AutomationProperties.Name="主题色" Style="{StaticResource QuietButton}" Click="OnThemeColorClick"><StackPanel Orientation="Horizontal"><Rectangle Width="12" Height="12" Fill="{DynamicResource Accent}" Stroke="{StaticResource InputLine}" StrokeThickness="0.5" Margin="0,0,7,0"/><TextBlock Text="主题色"/></StackPanel></Button>
                <Button x:Name="ResetThemeColorButton" AutomationProperties.Name="恢复默认主题色" Content="重置" ToolTip="恢复默认主题色" Style="{StaticResource QuietButton}" Click="OnResetThemeColorClick"/>
                <Border Background="{StaticResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="12,5" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ControlModeText" Text="固件控制" FontWeight="SemiBold"/></Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel>
                <TextBlock Text="CPU 温度" Style="{StaticResource Caption}"/><TextBlock x:Name="CpuTemperatureText" Style="{StaticResource Metric}" Text="不可用"/>
            </StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel>
                <TextBlock Text="GPU 温度" Style="{StaticResource Caption}"/><TextBlock x:Name="GpuTemperatureText" Style="{StaticResource Metric}" Text="不可用"/>
            </StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="0,0,10,0"><StackPanel>
                <TextBlock Text="风扇 1 · 实际转速" Style="{StaticResource Caption}"/><TextBlock x:Name="Fan1ActualText" Style="{StaticResource Metric}" Text="不可用"/>
                <TextBlock x:Name="Fan1TargetText" Text="已应用目标：—" Style="{StaticResource Caption}"/>
            </StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCard}"><StackPanel>
                <TextBlock Text="风扇 2 · 实际转速" Style="{StaticResource Caption}"/><TextBlock x:Name="Fan2ActualText" Style="{StaticResource Metric}" Text="不可用"/>
                <TextBlock x:Name="Fan2TargetText" Text="已应用目标：—" Style="{StaticResource Caption}"/>
            </StackPanel></Border>
        </Grid>

        <ScrollViewer x:Name="EditorScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,8">
            <StackPanel>
                <TabControl x:Name="EditorTabs" SelectionChanged="OnEditorTabChanged">
                    <TabItem Header="自动曲线">
                        <StackPanel x:Name="CurveEditorPanel">
                            <WrapPanel Margin="0,0,0,10">
                                <ComboBox x:Name="PresetPicker" Width="195" DisplayMemberPath="Name" SelectionChanged="OnPresetChanged" AutomationProperties.Name="双路曲线预设" Margin="0,0,8,0"/>
                                <Button x:Name="SavePresetButton" Content="保存" Click="OnSavePresetClick"/>
                                <Button x:Name="SaveAsPresetButton" Content="另存为" Click="OnSaveAsPresetClick"/>
                                <Button x:Name="RenamePresetButton" Style="{StaticResource QuietButton}" Content="重命名" Click="OnRenamePresetClick"/>
                                <Button x:Name="DeletePresetButton" Style="{StaticResource QuietButton}" Content="删除" Click="OnDeletePresetClick"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="转速曲线 · 拖拽 1°C / 100 RPM" Style="{StaticResource SmallTitle}" Margin="0,0,0,8"/>
                                <TextBlock Grid.Column="2" Text="节点参数 · 末点 7500 RPM / ≤90°C" Style="{StaticResource SmallTitle}" Margin="0,0,0,8"/>
                                <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource PlotSurface}">
                                    <controls:CurveEditor x:Name="CurveGraph" Margin="4" AutomationProperties.Name="双路温度转速曲线，方向键调整所选节点"/>
                                </Border>
                                <DataGrid x:Name="NodeGrid" Grid.Row="1" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                          HeadersVisibility="Column" SelectionMode="Single" MinRowHeight="36" BeginningEdit="OnNodeBeginningEdit" CellEditEnding="OnNodeCellEditEnding" AutomationProperties.Name="当前风扇曲线节点">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="温度 °C" Binding="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridTextColumn Header="目标 RPM" Binding="{Binding Rpm, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                        <DataGridTextColumn Header="校验" Binding="{Binding Error}" IsReadOnly="True" Width="138">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{StaticResource Error}"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="12"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                                    <RadioButton x:Name="Fan1Choice" Content="风扇 1" IsChecked="True" Checked="OnSelectedFanChanged" Foreground="{DynamicResource AccentInk}" Margin="0,0,6,0"/>
                                    <RadioButton x:Name="Fan2Choice" Content="风扇 2" Checked="OnSelectedFanChanged" Foreground="{StaticResource Fan2}" Margin="0,0,6,0"/>
                                    <Button Content="复制 1 → 2" ToolTip="将风扇 1 曲线复制到风扇 2" AutomationProperties.Name="复制风扇 1 曲线到风扇 2" Style="{StaticResource QuietButton}" Click="OnCopyFan1Click"/>
                                    <Button Content="复制 2 → 1" ToolTip="将风扇 2 曲线复制到风扇 1" AutomationProperties.Name="复制风扇 2 曲线到风扇 1" Style="{StaticResource QuietButton}" Click="OnCopyFan2Click"/>
                                </WrapPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,10,0,0">
                                    <WrapPanel><Button x:Name="AddNodeButton" Content="增加节点" Click="OnAddNodeClick"/><Button x:Name="RemoveNodeButton" Content="删除所选" ToolTip="删除选中的节点；至少保留两个节点" Click="OnRemoveNodeClick"/></WrapPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="CurveValidationText" Style="{StaticResource InlineError}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="手动控制">
                        <StackPanel x:Name="ManualEditorPanel">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ManualCard}"><StackPanel>
                                    <TextBlock Text="风扇 1" Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold"/>
                                    <TextBlock Text="目标转速 · RPM" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                                    <TextBox x:Name="Fan1RpmBox" Text="3600" FontSize="30" FontWeight="SemiBold" TextChanged="OnManualDraftChanged" AutomationProperties.Name="风扇 1 目标转速 RPM"/>
                                    <TextBlock Text="1500–7500 · 每次 100 RPM" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                </StackPanel></Border>
                                <Border Grid.Column="2" Style="{StaticResource ManualCard}"><StackPanel>
                                    <TextBlock Text="风扇 2" Foreground="{StaticResource Fan2}" FontWeight="SemiBold"/>
                                    <TextBlock Text="目标转速 · RPM" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                                    <TextBox x:Name="Fan2RpmBox" Text="3600" FontSize="30" FontWeight="SemiBold" TextChanged="OnManualDraftChanged" AutomationProperties.Name="风扇 2 目标转速 RPM"/>
                                    <TextBlock Text="1500–7500 · 每次 100 RPM" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                                </StackPanel></Border>
                            </Grid>
                            <TextBlock x:Name="ManualValidationText" Style="{StaticResource InlineError}" Margin="0,12,0,0"/>
                            <TextBlock Text="CPU ≥90°C 时自动启用高温保护。" Style="{StaticResource Caption}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
                <Expander Header="设备与诊断详情" Margin="0,12,0,0"><StackPanel Margin="12,10">
                    <TextBlock x:Name="ModelText"/><TextBlock x:Name="BiosText"/><TextBlock x:Name="BiosDateText"/><TextBlock x:Name="ThermalText"/><TextBlock x:Name="VpcText"/>
                    <GroupBox x:Name="SensorsGroup" Header="传感器 · 每秒采样" Margin="0,8"><ScrollViewer x:Name="SensorsScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="TemperatureText" FontFamily="Consolas"/></ScrollViewer></GroupBox>
                    <TextBlock x:Name="StatusText"/><ScrollViewer x:Name="ErrorsScroll" MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ErrorsText" Foreground="{StaticResource Error}"/></ScrollViewer>
                </StackPanel></Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock x:Name="DraftStatusText" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                <TextBlock x:Name="ControlStatusText" Style="{StaticResource InlineError}" Foreground="{StaticResource Ink}" Margin="0,0,0,6"/>
                <TextBlock x:Name="SettingsStatusText" Style="{StaticResource InlineError}" Margin="0,0,0,5"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="ApplyButton" Content="应用自动曲线" Style="{StaticResource PrimaryButton}" Click="OnApplyClick"/>
                    <Button x:Name="RestoreButton" Grid.Column="1" Content="恢复固件控制" Click="OnRestoreFirmwareClick"/>
                </Grid>
            </StackPanel>
        </Border>
        <TextBox x:Name="Fan1CurveBox" Visibility="Collapsed" Text="40:2500;60:3500;75:5000;90:7500"/>
        <TextBox x:Name="Fan2CurveBox" Visibility="Collapsed" Text="40:2500;60:3500;75:5000;90:7500"/>
    </Grid>
</Window>


