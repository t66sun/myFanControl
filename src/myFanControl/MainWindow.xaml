<Window x:Class="myFanControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:myFanControl.Controls" Title="myFanControl · 风扇控制" Width="960" Height="760" MinWidth="800" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#EFF2F6" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#192B3D">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/VisualTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="22,16" Background="#EFF2F6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="myFanControl" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="温度监测 / 双路风扇控制" Style="{StaticResource Caption}" FontSize="11" Margin="0,1,0,0"/></StackPanel><Border Grid.Column="1" Background="White" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,8" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="当前模式" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock x:Name="ControlModeText" Text="固件控制" FontWeight="SemiBold"/></StackPanel></Border></Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#DFE6ED" BorderThickness="1" Padding="18,12" Margin="0,0,0,12"><UniformGrid Columns="4">
   <StackPanel><TextBlock Text="CPU 温度" Foreground="#637384"/><TextBlock x:Name="CpuTemperatureText" Style="{StaticResource Metric}" Text="不可用"/><TextBlock Text="两路曲线的控制温度" Foreground="#637384" Margin="0,4,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="GPU 温度" Foreground="#637384"/><TextBlock x:Name="GpuTemperatureText" Style="{StaticResource Metric}" Text="不可用"/><TextBlock Text="仅用于监测" Foreground="#637384" Margin="0,4,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="风扇 1 · 实际 RPM" Foreground="#637384"/><TextBlock x:Name="Fan1ActualText" Style="{StaticResource Metric}" Text="不可用"/><TextBlock x:Name="Fan1TargetText" Text="已应用目标：—" Foreground="#637384" Margin="0,4,0,0"/></StackPanel>
   <StackPanel><TextBlock Text="风扇 2 · 实际 RPM" Foreground="#637384"/><TextBlock x:Name="Fan2ActualText" Style="{StaticResource Metric}" Text="不可用"/><TextBlock x:Name="Fan2TargetText" Text="已应用目标：—" Foreground="#637384" Margin="0,4,0,0"/></StackPanel>
  </UniformGrid></Border>
  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <TabControl x:Name="EditorTabs" SelectionChanged="OnEditorTabChanged" Background="White" BorderBrush="#DFE6ED" Padding="14,10,14,12">
    <TabItem Header="自动曲线"><StackPanel x:Name="CurveEditorPanel">
     <DockPanel Margin="0,0,0,8"><TextBlock Text="曲线配置" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="静态映射预览 · 拖拽节点调整" Foreground="#637384" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
     <WrapPanel Margin="0,0,0,10"><ComboBox x:Name="PresetPicker" Width="195" DisplayMemberPath="Name" SelectionChanged="OnPresetChanged" Margin="0,0,10,0"/><Button x:Name="SavePresetButton" Content="保存" Click="OnSavePresetClick"/><Button x:Name="SaveAsPresetButton" Content="另存为" Click="OnSaveAsPresetClick"/><Button x:Name="RenamePresetButton" Style="{StaticResource QuietButton}" Content="重命名" Click="OnRenamePresetClick"/><Button x:Name="DeletePresetButton" Style="{StaticResource QuietButton}" Content="删除" Click="OnDeletePresetClick"/></WrapPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <controls:CurveEditor x:Name="CurveGraph" Grid.Row="0" Grid.Column="0" Height="200"/>
      <DataGrid x:Name="NodeGrid" Grid.Row="0" Grid.Column="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" Height="200" MinRowHeight="30" BeginningEdit="OnNodeBeginningEdit" CellEditEnding="OnNodeCellEditEnding" BorderBrush="#DFE6ED"><DataGrid.Columns>
       <DataGridTextColumn Header="温度 °C" Binding="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}" Width="80"/><DataGridTextColumn Header="目标 RPM" Binding="{Binding Rpm, UpdateSourceTrigger=PropertyChanged}" Width="90"/><DataGridTextColumn Header="校验" Binding="{Binding Error}" IsReadOnly="True" Width="138"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#B03D32"/><Setter Property="Margin" Value="4"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
      </DataGrid.Columns></DataGrid>
      <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"><RadioButton x:Name="Fan1Choice" Content="风扇 1 · 蓝线" IsChecked="True" Checked="OnSelectedFanChanged" Margin="0,7,12,0" Foreground="#245FBE"/><RadioButton x:Name="Fan2Choice" Content="风扇 2 · 橙线" Checked="OnSelectedFanChanged" Margin="0,7,12,0" Foreground="#A66720"/><Button Content="1 → 2 复制" ToolTip="将风扇 1 曲线复制到风扇 2" Style="{StaticResource QuietButton}" Click="OnCopyFan1Click"/><Button Content="2 → 1 复制" ToolTip="将风扇 2 曲线复制到风扇 1" Style="{StaticResource QuietButton}" Click="OnCopyFan2Click"/></WrapPanel>
      <WrapPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"><Button x:Name="AddNodeButton" Content="增加节点" Click="OnAddNodeClick"/><Button x:Name="RemoveNodeButton" Content="删除所选节点" Click="OnRemoveNodeClick"/></WrapPanel>
     </Grid>
     <TextBlock Text="至少 2 个节点；末点固定 7500 RPM，温度 ≤ 90°C。" Foreground="#637384" Margin="0,6,0,0" FontSize="12"/>
     <TextBlock x:Name="CurveValidationText" Foreground="#B03D32" Margin="0,8,0,0"/>
    </StackPanel></TabItem>
    <TabItem Header="手动控制"><StackPanel x:Name="ManualEditorPanel" Margin="4,10"><TextBlock Text="固定双路转速" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="允许 1500–7500 RPM，步长 100。CPU 达到 90°C 时仍会启用高温保护。" Foreground="#637384" Margin="0,8,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="风扇 1 · RPM"/><TextBox x:Name="Fan1RpmBox" FontSize="24" FontWeight="SemiBold" Text="3600" TextChanged="OnManualDraftChanged" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="风扇 2 · RPM"/><TextBox x:Name="Fan2RpmBox" FontSize="24" FontWeight="SemiBold" Text="3600" TextChanged="OnManualDraftChanged" Margin="0,8,0,0"/></StackPanel></Grid><TextBlock x:Name="ManualValidationText" Foreground="#B03D32" Margin="0,10,0,0"/><TextBlock Text="修改输入不会改变转速。点击下方“应用手动转速”后才启用控制。" Foreground="#637384" Margin="0,18,0,0"/></StackPanel></TabItem>
   </TabControl>
   <Expander Header="设备、完整传感器与诊断详情" Margin="0,14,0,12"><StackPanel Margin="12,10"><TextBlock x:Name="ModelText"/><TextBlock x:Name="BiosText"/><TextBlock x:Name="BiosDateText"/><TextBlock x:Name="ThermalText"/><TextBlock x:Name="VpcText"/><GroupBox x:Name="SensorsGroup" Header="每秒采样" Margin="0,8"><ScrollViewer x:Name="SensorsScroll" MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="TemperatureText" FontFamily="Consolas"/></ScrollViewer></GroupBox><TextBlock x:Name="StatusText"/><ScrollViewer x:Name="ErrorsScroll" MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ErrorsText" Foreground="#B03D32"/></ScrollViewer></StackPanel></Expander>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="3" BorderBrush="#DFE6ED" BorderThickness="0,1,0,0" Padding="0,8,0,0"><StackPanel><TextBlock x:Name="DraftStatusText" Foreground="#637384" Margin="0,0,0,6"/><TextBlock x:Name="ControlStatusText" Text="当前由固件控制；控制功能不会在启动时自动启用。" Margin="0,0,0,5"/><TextBlock x:Name="SettingsStatusText" Foreground="#B03D32" Margin="0,0,0,5"/><DockPanel><Button x:Name="ApplyButton" Content="应用自动曲线" Style="{StaticResource PrimaryButton}" Click="OnApplyClick"/><Button x:Name="RestoreButton" Content="恢复固件控制" Padding="16,9" Click="OnRestoreFirmwareClick"/><TextBlock Text="关闭窗口后继续在托盘运行" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#637384"/></DockPanel></StackPanel></Border>
  <TextBox x:Name="Fan1CurveBox" Visibility="Collapsed" Text="40:2500;60:3500;75:5000;90:7500"/><TextBox x:Name="Fan2CurveBox" Visibility="Collapsed" Text="40:2500;60:3500;75:5000;90:7500"/>
 </Grid>
</Window>


